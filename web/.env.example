NEXT_PUBLIC_CLOUDBASE_ENV_ID=replace-with-env-id
# Optional for anonymous public-resource access; account authentication does not use it.
NEXT_PUBLIC_CLOUDBASE_PUBLISH_KEY=
NEXT_PUBLIC_INVITE_CHECK_URL=https://your-env.service.tcloudbase.com/api/v1/invitations/verify
NEXT_PUBLIC_AMAP_KEY=replace-with-amap-js-key
NEXT_PUBLIC_AMAP_SECURITY_CODE=replace-with-amap-security-code
NEXT_PUBLIC_BAIDU_MAP_AK=replace-with-baidu-browser-ak
NEXT_PUBLIC_PHOTO_API_BASE=https://your-env.service.tcloudbase.com/photo-api
